# ============================================================================
#  Self-hosted mail server configuration
#  Copy this file to ".env" and edit the values, then run `make up`.
# ============================================================================

# --- Identity -----------------------------------------------------------------
# Your primary mail domain (the part after the @ in your addresses).
MAIL_DOMAIN=example.com

# Fully-qualified hostname of THIS server. Must have an A/AAAA record and a
# matching PTR (reverse DNS) record. This is what Postfix announces in HELO
# and what your TLS certificate must be issued for.
MAIL_HOSTNAME=mail.example.com

# DKIM selector used when signing outbound mail (any short token).
DKIM_SELECTOR=mail

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=mailserver
POSTGRES_USER=mailuser
# CHANGE THIS to a long random string before deploying.
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
# Hostname of the database service (the docker-compose service name).
POSTGRES_HOST=postgres

# --- TLS ----------------------------------------------------------------------
# Certificates are read from ./certs/{fullchain.pem,privkey.pem} which is
# mounted read-only into postfix and dovecot at /etc/ssl/mail.
# Use scripts/setup-tls.sh to generate a self-signed cert (testing) or to
# wire up Let's Encrypt (production). See docs/SETUP.md.
