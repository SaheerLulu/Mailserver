# ============================================================================
#  Django mail server configuration — copy to ".env" and edit.
# ============================================================================

# --- Django -----------------------------------------------------------------
# Generate a fresh one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
# Hostnames the web app answers on. Keep 127.0.0.1 so the healthcheck works.
DJANGO_ALLOWED_HOSTS=mail.example.com,localhost,127.0.0.1
# Needed when serving the webmail/admin over HTTPS behind a proxy.
DJANGO_CSRF_TRUSTED_ORIGINS=https://mail.example.com

# --- Mail server identity ---------------------------------------------------
# FQDN of this server — needs an A record and a matching PTR (reverse DNS).
MAIL_HOSTNAME=mail.example.com
# Default DKIM selector used by `gendkim`.
DKIM_SELECTOR=mail

# --- SMTP -------------------------------------------------------------------
SMTP_INBOUND_PORT=25
SMTP_SUBMISSION_PORT=587
# Optional STARTTLS for the SMTP ports. Drop a cert/key into ./certs and point
# these at them (paths are inside the container). Leave blank to disable TLS
# (and AUTH will then be allowed without it — fine for local testing only).
SMTP_TLS_CERT=
SMTP_TLS_KEY=
# e.g. SMTP_TLS_CERT=/app/certs/fullchain.pem
#      SMTP_TLS_KEY=/app/certs/privkey.pem

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=mailserver
POSTGRES_USER=mailuser
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Misc -------------------------------------------------------------------
TZ=UTC
LOG_LEVEL=INFO
